{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "magnify-eta.vercel.app" }],
      "destination": "https://magnify.gatheredin.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "magnify-eta.vercel.app" }],
      "destination": "https://magnify.gatheredin.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/calling/:callingId", "destination": "/index.html" },
    { "source": "/((?!apple-touch-icon\\.png|favicon\\.png|manifest\\.json|sw\\.js|assets/.*|_expo/.*).*)", "destination": "/index.html" }
  ]
}
